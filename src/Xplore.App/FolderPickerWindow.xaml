<Window x:Class="Xplore.App.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Xplore.App.Localization"
        Title="{l:Loc Sync.Dialog.Folder}"
        Width="460" Height="480" MinWidth="320" MinHeight="300" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" FontSize="12">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{l:Loc Common.Open}" Width="80" Height="26" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{l:Loc Common.Cancel}" Width="80" Height="26" IsCancel="True"/>
        </StackPanel>
        <TextBox x:Name="PathBox" DockPanel.Dock="Bottom" Height="26" Margin="0,8,0,0" Padding="4,0" VerticalContentAlignment="Center" BorderBrush="#D9D9D9"/>
        <TreeView x:Name="Tree" BorderBrush="#D9D9D9">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="ToolTip" Value="{Binding Path}"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</Window>
