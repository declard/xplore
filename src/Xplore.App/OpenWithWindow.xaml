<Window x:Class="Xplore.App.OpenWithWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Xplore.App.Localization"
        Title="{l:Loc OpenWith.Title}" Width="440" Height="480" MinWidth="420" MinHeight="300" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" FontSize="12">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{l:Loc Common.Browse}" Width="80" Height="26" Margin="0,0,8,0" Click="Browse_Click"/>
            <Button Content="{l:Loc OpenWith.SystemDialog}" Width="110" Height="26" Margin="0,0,8,0" Click="System_Click"/>
            <Button x:Name="OpenButton" Content="{l:Loc Common.Open}" Width="80" Height="26" Margin="0,0,8,0" IsDefault="True" IsEnabled="False" Click="Open_Click"/>
            <Button Content="{l:Loc Common.Cancel}" Width="80" Height="26" IsCancel="True"/>
        </StackPanel>
        <TextBlock x:Name="Header" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <ListBox x:Name="Apps" BorderBrush="#D9D9D9" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="Apps_SelectionChanged" MouseDoubleClick="Apps_DoubleClick">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#4C4C4C" Margin="4,8,0,2"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,3" ToolTip="{Binding App.Path}">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding App.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
