<Window x:Class="Xplore.App.HistoryDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Xplore.App.Localization"
        Width="520" Height="360" MinWidth="300" MinHeight="200" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" FontSize="12">
    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom" Content="{l:Loc Common.Close}" Width="80" Height="26" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True" IsDefault="True"/>
        <TextBox x:Name="Text" IsReadOnly="True" BorderBrush="#D9D9D9" TextWrapping="NoWrap" Padding="6"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
