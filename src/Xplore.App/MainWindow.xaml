<Window x:Class="Xplore.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Xplore.App.Localization"
        xmlns:local="clr-namespace:Xplore.App"
        Title="Xplore" Icon="app.ico" Width="1100" Height="700" FontFamily="Segoe UI" FontSize="12" Background="White"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown">
    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding NewTabCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#A0A0A0"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumbV" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#C8C8C8" CornerRadius="2" Width="4" HorizontalAlignment="Center" Margin="0,1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#A0A0A0"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bd" Property="Background" Value="#808080"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumbH" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#C8C8C8" CornerRadius="2" Height="4" VerticalAlignment="Center" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#A0A0A0"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bd" Property="Background" Value="#808080"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalBar" TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumbV}"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
            </Track>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalBar" TargetType="ScrollBar">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumbH}"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
            </Track>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Template" Value="{StaticResource VerticalBar}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalBar}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Padding" Value="6,6,4,6"/>
            <Setter Property="Foreground" Value="#4C4C4C"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid Background="White">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                <Grid>
                                    <Path x:Name="Chevron" Data="M 0,4 L 4,0 L 8,4" Stroke="#6D6D6D" StrokeThickness="1" Visibility="Collapsed"
                                          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" RenderTransformOrigin="0.5,0.5"/>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Rectangle x:Name="Sep" Width="1" Fill="#E5E5E5" HorizontalAlignment="Right"/>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Margin="0,0,-3,0" Width="7" Cursor="SizeWE">
                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E5F3FF"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5F3FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="Role" Value="Padding">
                                <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="local:HeaderSort.Direction" Value="1">
                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="local:HeaderSort.Direction" Value="2">
                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleY="-1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ToolButton_MouseDown"/>
            <EventSetter Event="LostMouseCapture" Handler="ToolButton_LostMouseCapture"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E5F3FF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#CCE8FF"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5F3FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BookmarkButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBookmarked}" Value="True"><Setter Property="Foreground" Value="#E8A600"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DiskBar" TargetType="ProgressBar">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="5"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Margin" Value="0,2,0,1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#E6E6E6"/>
            <Setter Property="Foreground" Value="#26A0DA"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNearlyFull}" Value="True"><Setter Property="Foreground" Value="#D13438"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CrumbButton" TargetType="Button">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E5F3FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="10,5,6,5" Margin="0,0,2,0" Background="Transparent"
                                BorderBrush="#D3DCEA" BorderThickness="1,1,1,0" CornerRadius="5,5,0,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E1EBF8"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Tab_MouseDown"/>
            <EventSetter Event="PreviewMouseMove" Handler="Tab_MouseMove"/>
            <EventSetter Event="MouseUp" Handler="Tab_MouseUp"/>
            <EventSetter Event="DragOver" Handler="Tab_DragOver"/>
            <EventSetter Event="Drop" Handler="Tab_Drop"/>
        </Style>

        <Style x:Key="TabStrip" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <StackPanel Orientation="Horizontal" Background="#EEF4FB">
                            <TabPanel IsItemsHost="True" Margin="6,6,0,0" VerticalAlignment="Bottom"/>
                            <Button Content="+" Width="26" Height="24" Margin="2,6,0,0" Background="Transparent" BorderThickness="0"
                                    FontSize="16" Command="{Binding DataContext.NewTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="ToolTip" Value="{Binding Path}"/>
            <EventSetter Event="Selected" Handler="TreeItem_Selected"/>
        </Style>

        <Style x:Key="ListItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="ToolTip" Value="{Binding Entry.Path}"/>
            <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
        </Style>

        <Style x:Key="NameText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlaceholderText" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Search.Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#EEF4FB">
            <TabControl Style="{StaticResource TabStrip}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Content="✕" Margin="8,0,0,0" Width="18" Height="18" FontSize="10" Background="Transparent" BorderThickness="0"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>

                <Button x:Name="SyncButton" Style="{StaticResource ToolButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,74,0" Content="&#xE895;" Click="SyncButton_Click" ToolTip="{l:Loc Main.Sync.ToolTip}"/>
                <Button x:Name="HistoryButton" Style="{StaticResource ToolButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0" Content="&#xE81C;" Click="HistoryButton_Click" ToolTip="{l:Loc Main.History.ToolTip}"/>
                <Button x:Name="SettingsButton" Style="{StaticResource ToolButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Content="&#xE713;" Click="SettingsButton_Click" ToolTip="{l:Loc Main.Settings.ToolTip}"/>
                <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=HistoryButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="#BFBFBF" BorderThickness="1" Padding="4" MinWidth="220" MaxHeight="420">
                        <TreeView x:Name="HistoryTree" BorderThickness="0" PreviewMouseRightButtonDown="HistoryTree_RightClick">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True"/>
                                    <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="HistoryNode_Click"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Label}" Margin="2,1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGreyed}" Value="True"><Setter Property="Foreground" Value="#9A9A9A"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>
                </Popup>
        </Grid>

        <Grid Grid.Row="1" DataContext="{Binding SelectedTab}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Content="&#xE72B;" Command="{Binding BackCommand}" ToolTip="{l:Loc Main.Back.ToolTip}" MouseRightButtonUp="Back_RightClick"/>
                    <Button x:Name="ForwardButton" Style="{StaticResource ToolButton}" Content="&#xE72A;" Command="{Binding ForwardCommand}" ToolTip="{l:Loc Main.Forward.ToolTip}" MouseRightButtonUp="Forward_RightClick"/>
                    <Button x:Name="UpButton" Style="{StaticResource ToolButton}" Content="&#xE74A;" Command="{Binding UpCommand}" ToolTip="{l:Loc Main.Up.ToolTip}"/>
                    <Button x:Name="CollapseTreeButton" Style="{StaticResource ToolButton}" Command="{Binding Tree.CollapseCommand}" ToolTip="{l:Loc Main.Collapse.ToolTip}">
                        <Path Data="M0,4.5 L4,0.5 L8,4.5 M0,9.5 L4,5.5 L8,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                    </Button>
                    <Button x:Name="BookmarkButton" Style="{StaticResource BookmarkButton}" Content="{Binding BookmarkGlyph}" Command="{Binding ToggleBookmarkCommand}"
                            ToolTip="{Binding BookmarkTooltip}"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="6,0" Height="30">
                    <Border x:Name="CrumbBar" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3" Background="White"
                            MouseLeftButtonDown="CrumbBar_MouseDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding FolderIcon}" Width="16" Height="16" Margin="8,0,2,0"/>
                            <Button x:Name="CrumbOverflow" Grid.Column="1" Style="{StaticResource CrumbButton}" Content="&#xAB;" Visibility="Collapsed"
                                    Focusable="False" Click="CrumbOverflow_Click" ToolTip="{l:Loc Main.WholePath.ToolTip}"/>
                            <ItemsControl x:Name="CrumbList" Grid.Column="2" ItemsSource="{Binding Address.Breadcrumbs}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><local:CrumbPanel Loaded="CrumbPanel_Loaded"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Tag="CrumbItem" Focusable="True" FocusVisualStyle="{x:Null}" AllowDrop="True" DragOver="Crumb_DragOver" Drop="Crumb_Drop">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="CornerRadius" Value="3"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter Property="Background" Value="#E5F3FF"/>
                                                            <Setter Property="BorderBrush" Value="#0078D7"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding Name}" Style="{StaticResource CrumbButton}" Focusable="False" Click="Crumb_Click"/>
                                                <Button Content="›" Style="{StaticResource CrumbButton}" Focusable="False" Padding="4,3" Click="CrumbArrow_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Grid.Column="3" Style="{StaticResource CrumbButton}" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                    FontSize="12" Padding="9,3" Command="{Binding RefreshCommand}" ToolTip="{l:Loc Main.Refresh.ToolTip}"/>
                        </Grid>
                    </Border>
                    <TextBox x:Name="AddressBox" Visibility="Collapsed" VerticalContentAlignment="Center" Padding="6,0"
                             Text="{Binding Address.Text, UpdateSourceTrigger=PropertyChanged}"
                             GotKeyboardFocus="Address_GotFocus" LostKeyboardFocus="Address_LostFocus" PreviewKeyDown="Address_KeyDown"/>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="CopyLocationButton" Style="{StaticResource ToolButton}" Content="&#xE8C8;" Command="{Binding Files.CopyLocationCommand}" ToolTip="{l:Loc Main.CopyLocation.ToolTip}"/>
                    <Button x:Name="OpenCmdButton" Style="{StaticResource ToolButton}" Content="&#xE756;" Command="{Binding OpenCmdCommand}" ToolTip="{l:Loc Main.OpenCmd.ToolTip}"/>
                </StackPanel>

                <Grid Grid.Column="3" Height="30">
                    <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Padding="8,0,26,0"
                             ToolTip="{l:Loc Main.Search.ToolTip}"
                             Text="{Binding Search.Text, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Search_KeyDown"/>
                    <TextBlock Text="{Binding SearchPlaceholder}"
                               IsHitTestVisible="False" Foreground="#6D6D6D" Margin="9,0,26,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Search.Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#4C4C4C"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TreeView x:Name="Tree" Grid.Column="0" BorderThickness="0" ItemsSource="{Binding Tree.Nodes}" ItemContainerStyle="{StaticResource TreeItem}"
                          AllowDrop="True" DragOver="Tree_DragOver" Drop="Tree_Drop"
                          PreviewMouseLeftButtonDown="Tree_MouseDown" PreviewMouseRightButtonDown="Tree_MouseDown" PreviewMouseRightButtonUp="Tree_RightClick" PreviewMouseMove="Tree_MouseMove" PreviewKeyDown="Tree_PreviewKeyDown">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MinWidth="140" Padding="2,0" Height="18" Margin="0,-2" VerticalContentAlignment="Center"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                             PreviewKeyDown="BookmarkRename_KeyDown" LostKeyboardFocus="BookmarkRename_LostFocus"/>
                                    <ProgressBar Style="{StaticResource DiskBar}" Value="{Binding UsedFraction, Mode=OneWay, FallbackValue=0}"
                                                 Visibility="{Binding HasUsage, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ShowsPreview="False">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent"><Rectangle Width="1" Fill="#DADADA" HorizontalAlignment="Center"/></Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListView x:Name="Details" BorderThickness="0" FocusVisualStyle="{x:Null}" ItemsSource="{Binding Items}"
                          SelectionMode="Extended" ItemContainerStyle="{StaticResource ListItem}" AllowDrop="True"
                          SelectionChanged="Details_SelectionChanged" GridViewColumnHeader.Click="Header_Click"
                          ContextMenuOpening="Details_ContextMenuOpening" PreviewKeyDown="Details_PreviewKeyDown" PreviewTextInput="Details_TextInput"
                          PreviewMouseRightButtonDown="Details_RightDown" PreviewMouseLeftButtonDown="Details_MouseDown"
                          PreviewMouseMove="Details_MouseMove" PreviewMouseLeftButtonUp="Details_MouseUp" LostMouseCapture="Details_LostCapture"
                          DragOver="Details_DragOver" Drop="Details_Drop">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="320">
                                <GridViewColumn.Header><GridViewColumnHeader Tag="Name" Content="{l:Loc Column.Name}"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" Tag="NameCell"/>
                                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MinWidth="160" Padding="2,0" Height="18" Margin="0,-2" VerticalContentAlignment="Center"
                                                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                                     PreviewKeyDown="Rename_KeyDown"
                                                     LostKeyboardFocus="Rename_LostFocus"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="150" DisplayMemberBinding="{Binding ModifiedText}">
                                <GridViewColumn.Header><GridViewColumnHeader Tag="Modified" Content="{l:Loc Column.Modified}"/></GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="140" DisplayMemberBinding="{Binding TypeName}">
                                <GridViewColumn.Header><GridViewColumnHeader Tag="Type" Content="{l:Loc Column.Type}"/></GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="90">
                                <GridViewColumn.Header><GridViewColumnHeader Tag="Size" Content="{l:Loc Column.Size}"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" TextAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="BandRect" Visibility="Collapsed" Stroke="#0078D7" StrokeThickness="1" Fill="#330078D7"/>
                </Canvas>
                <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0" Background="Transparent" Foreground="#0078D7"
                             VerticalAlignment="Top" IsHitTestVisible="False" Margin="0,24,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                <Border x:Name="ConsolePanel" Grid.Row="1" BorderBrush="#DADADA" BorderThickness="0,1,0,0" Background="White"
                        PreviewKeyDown="Console_PreviewKeyDown" AllowDrop="True" PreviewDragOver="Console_DragOver" PreviewDrop="Console_Drop"
                        Visibility="{Binding Terminal.IsExpanded, Converter={StaticResource BoolToVis}}">
                    <DockPanel DataContext="{Binding Terminal}">
                        <Thumb DockPanel.Dock="Top" Height="5" Cursor="SizeNS" DragDelta="ConsoleSplitter_DragDelta"
                               Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
                        </Thumb>
                        <Grid x:Name="ConsoleBody" Height="170" IsEnabled="{Binding IsActive}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="Background" Value="#F0F0F0"/>
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="ConsoleOutput" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="6,4"
                                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Text="{Binding Output, Mode=OneWay}" TextChanged="ConsoleOutput_TextChanged"/>
                            <Rectangle Grid.Row="1" Height="1" Fill="#DADADA" VerticalAlignment="Top"/>
                            <DockPanel Grid.Row="1" Margin="6,5,6,5">
                                <TextBlock FontFamily="Consolas" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&gt;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Text" Value="…"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid>
                                    <TextBox x:Name="ConsoleInput" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12"
                                             IsReadOnly="{Binding IsRunning}" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="ConsoleInput_KeyDown"/>
                                    <TextBlock Text="{l:Loc Main.Console.Unavailable}" Foreground="#6D6D6D" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
                </Grid>
            </Grid>

            <StatusBar Grid.Row="2" Background="White">
                <StatusBarItem DockPanel.Dock="Right">
                    <Button x:Name="ConsoleToggle" Click="ConsoleButton_Click" FocusVisualStyle="{x:Null}" ToolTip="{l:Loc Main.Console.ToolTip}" Padding="8,2" Margin="0,0,2,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{l:Loc Main.Console.Title}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Terminal.IsExpanded}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#CCE8FF"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E5F3FF"/></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E5F3FF"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Margin="4,0"/>
                <Separator/>
                <TextBlock Text="{Binding SelectionText}"/>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
