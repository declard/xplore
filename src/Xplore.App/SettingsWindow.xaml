<Window x:Class="Xplore.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Xplore.App.Localization"
        Title="{l:Loc Settings.Title}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White"
        FontFamily="Segoe UI" FontSize="12">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="{l:Loc Settings.OpenFile}" Padding="10,0" Height="26" Click="OpenFile_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="{l:Loc Common.Save}" Width="80" Height="26" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
                <Button Content="{l:Loc Common.Cancel}" Width="80" Height="26" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="Error" DockPanel.Dock="Bottom" Foreground="#C42B1C" TextWrapping="Wrap" MinHeight="18" Margin="0,8,0,0"/>
        <TextBlock DockPanel.Dock="Bottom" Text="{l:Loc Settings.RestartNote}" Foreground="#666666" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,12,10"/>
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Padding" Value="4,3"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Padding" Value="3,2"/>
                </Style>
                <Style TargetType="CheckBox">
                    <Setter Property="Margin" Value="0,0,0,10"/>
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Text="{l:Loc Settings.Language}"/>
            <ComboBox x:Name="LanguageBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" DisplayMemberPath="Name" SelectedValuePath="Code"/>

            <CheckBox x:Name="ForwardSlashesBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="{l:Loc Settings.ForwardSlashes}"/>
            <CheckBox x:Name="NewFolderPromptBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="{l:Loc Settings.NewFolderPrompt}"/>
            <CheckBox x:Name="FoldersFirstBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Content="{l:Loc Settings.FoldersFirst}"/>

            <TextBlock Grid.Row="4" Text="{l:Loc Settings.DateFormat}"/>
            <ComboBox x:Name="DateFormatBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" DisplayMemberPath="Label" SelectedValuePath="Value"/>

            <TextBlock Grid.Row="5" Text="{l:Loc Settings.LongTimeFormat}"/>
            <ComboBox x:Name="LongTimeFormatBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" DisplayMemberPath="Label" SelectedValuePath="Value"/>

            <TextBlock Grid.Row="6" Text="{l:Loc Settings.ShortTimeFormat}"/>
            <ComboBox x:Name="ShortTimeFormatBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" DisplayMemberPath="Label" SelectedValuePath="Value"/>

            <TextBlock Grid.Row="7" Text="{l:Loc Settings.HistoryDepth}"/>
            <TextBox x:Name="HistoryDepthBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" TextChanged="Input_Changed"/>

            <TextBlock Grid.Row="8" Text="{l:Loc Settings.PrefixTimeout}"/>
            <TextBox x:Name="PrefixTimeoutBox" Grid.Row="8" Grid.Column="1" TextChanged="Input_Changed"/>
            <TextBlock Grid.Row="8" Grid.Column="2" Text="{l:Loc Settings.Milliseconds}" Margin="6,0,0,10"/>

            <TextBlock Grid.Row="9" Text="{l:Loc Settings.StartLocation}"/>
            <ComboBox x:Name="StartTypeBox" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="StartType_Changed"/>

            <TextBlock Grid.Row="10" Text="{l:Loc Settings.CustomPath}"/>
            <TextBox x:Name="CustomPathBox" Grid.Row="10" Grid.Column="1" Margin="0,0,8,0"/>
            <Button x:Name="BrowseButton" Grid.Row="10" Grid.Column="2" Content="{l:Loc Common.Browse}" Padding="10,0" Click="Browse_Click"/>
        </Grid>
    </DockPanel>
</Window>
